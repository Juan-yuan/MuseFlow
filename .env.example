# Same MODEL_* settings as Knowledge-Graph (OpenAI-compatible)
# Copy this file to .env and fill in real values. .env is gitignored.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.6-luna
IMAGE_MODEL_NAME=gpt-image-2

# Optional browser flag for Zhihu publish node
# ZHIHU_HEADLESS=false

# ---- MuseFlow private node logic (required; do not commit real values) ----
# String values may be written as JSON-quoted strings (recommended for multiline).
# List/object values must be valid JSON.

ZHIHU_CONTENT_SYSTEM_PROMPT=
ZHIHU_CONTENT_HUMAN_TEMPLATE=
ZHIHU_CONTENT_TITLE_DESC=
ZHIHU_CONTENT_BODY_DESC=
ZHIHU_CONTENT_SITE_DESC=

ZHIHU_IMAGE_SYSTEM_PROMPT=
ZHIHU_IMAGE_HUMAN_TEMPLATE=
ZHIHU_IMAGE_PROMPTS_DESC=
ZHIHU_IMAGE_COUNT=3
ZHIHU_IMAGE_SIZE=1536x1024

ZHIHU_TRANSLATE_SYSTEM_PROMPT=
ZHIHU_TRANSLATE_HUMAN_TEMPLATE=
ZHIHU_TRANSLATE_TITLE_DESC=
ZHIHU_TRANSLATE_CONTENT_DESC=
ZHIHU_TRANSLATE_SITE_DESC=

ZHIHU_BANNED_WORDS=[]
ZHIHU_CHECK_TEXT_FIELDS=[]

ZHIHU_SIGNIN_URL=
ZHIHU_WRITE_URL=
ZHIHU_COOKIE_URL=
ZHIHU_LOGIN_COOKIE=
ZHIHU_LOGIN_TIMEOUT_MS=300000
ZHIHU_MAX_TOPICS=3
ZHIHU_STATE_FILENAME=
ZHIHU_SCREENSHOT_FILENAME=
ZHIHU_SIGNIN_URL_MARKER=
ZHIHU_GOTO_WAIT_UNTIL=
ZHIHU_TOPIC_SPLIT_REGEX=
ZHIHU_MARKDOWN_EXTENSIONS=[]
ZHIHU_VIEWPORT={}
ZHIHU_TIMEOUTS={}
ZHIHU_SELECTORS={}
ZHIHU_PASTE_JS=
ZHIHU_UPLOAD_WAIT_JS=
ZHIHU_STRUCTURED_OUTPUT_METHOD=
ZHIHU_DRY_RUN_TITLE=
ZHIHU_DRY_RUN_CONTENT=
ZHIHU_DRY_RUN_SITE=
